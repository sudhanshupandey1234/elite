// Prisma Schema for EliteGlobex Corporate Platform & CMS/ERP Suite

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. AUTHENTICATION & ACCESS CONTROL (RBAC)
// -------------------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("ADMIN") // SUPER_ADMIN, ADMIN, HR, SALES, MANAGER, EMPLOYEE, EDITOR
  status       String    @default("ACTIVE") // ACTIVE, INACTIVE
  department   String?
  phone        String?
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions      Session[]
  auditLogs     AuditLog[]
  tasks         ProjectTask[]
  assignedLeads Lead[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  userName    String?
  action      String   // LOGIN, LOGOUT, CREATE, UPDATE, DELETE, STATUS_CHANGE
  entity      String   // Service, Lead, Order, Invoice, Employee, Homepage, Navigation, etc.
  entityId    String?
  detailsJson String?  // JSON formatted details of the change
  ipAddress   String?
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// -------------------------------------------------------------
// 2. HOMEPAGE CMS & DYNAMIC SECTIONS
// -------------------------------------------------------------

model HomepageContent {
  id              String   @id @default("default")
  heroEyebrow     String   @default("GLOBAL TECHNOLOGY & DIGITAL SOLUTIONS")
  heroTitle       String   @default("Building Digital Solutions That Move")
  heroHighlight   String   @default("Businesses Forward.")
  heroDescription String   @default("EliteGlobex helps enterprises and ambitious companies design, build, and scale modern digital products, cloud platforms, and intelligent technology solutions with predictable velocity.")
  heroPrimaryBtnText String @default("Explore Our Services")
  heroPrimaryBtnUrl  String @default("/services")
  heroSecondaryBtnText String @default("Start a Project")
  heroSecondaryBtnUrl  String @default("/contact")
  heroTrackBtnText   String @default("Track Project")
  heroTrackBtnUrl    String @default("/track-order")
  heroBadgeText   String   @default("Operational")
  heroIsActive    Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

model HomepageSection {
  id          String   @id @default(cuid())
  sectionKey  String   @unique // hero, trust_strip, about, services, solutions, industries, why_us, process, projects, testimonials, blog, cta
  name        String   // Human-readable title
  title       String?  // Optional display heading
  subtitle    String?  // Optional display subtitle
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  customConfigJson String? // Optional JSON for extra section-specific properties
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 3. DYNAMIC NAVIGATION CMS
// -------------------------------------------------------------

model NavigationItem {
  id           String   @id @default(cuid())
  label        String
  href         String
  order        Int      @default(0)
  parentId     String?
  hasDropdown  Boolean  @default(false)
  dropdownType String?  // services, solutions, custom
  isSpecial    Boolean  @default(false)
  isActive     Boolean  @default(true)
  target       String   @default("_self")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -------------------------------------------------------------
// 4. CUSTOM PAGE BUILDER & BLOCKS
// -------------------------------------------------------------

model CustomPage {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  seoTitle    String?
  seoDesc     String?
  status      String      @default("PUBLISHED") // DRAFT, PUBLISHED, ARCHIVED
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  blocks      PageBlock[]
}

model PageBlock {
  id         String     @id @default(cuid())
  pageId     String
  blockType  String     // HERO, TEXT_IMAGE, FEATURES_GRID, CTA_BANNER, FAQ_ACCORDION, STATS_GRID, TESTIMONIALS
  title      String?
  subtitle   String?
  content    String?    // Rich text or markdown
  mediaUrl   String?
  order      Int        @default(0)
  configJson String?    // JSON configuration for items/features in the block
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  page CustomPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 5. CRM & INQUIRIES
// -------------------------------------------------------------

model Lead {
  id              String    @id @default(cuid())
  name            String
  email           String
  phone           String?
  company         String?
  serviceInterest String?
  source          String    @default("WEBSITE") // WEBSITE, REFERRAL, DIRECT, CAMPAIGN
  status          String    @default("NEW") // NEW, CONTACTED, QUALIFIED, PROPOSAL, WON, LOST
  priority        String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  notes           String?
  estimatedValue  Float?
  assignedToId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
}

model ContactSubmission {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  company     String?
  service     String?
  message     String
  sourcePage  String?  @default("/contact")
  status      String   @default("UNREAD") // UNREAD, READ, CONVERTED_TO_LEAD, ARCHIVED
  ipAddress   String?
  createdAt   DateTime @default(now())
}

// -------------------------------------------------------------
// 6. CMS: SERVICES, SOLUTIONS, INDUSTRIES, PROJECTS
// -------------------------------------------------------------

model Service {
  id             String   @id @default(cuid())
  slug           String   @unique
  title          String
  shortDesc      String
  fullDesc       String
  category       String   @default("Engineering") // Engineering, Cloud, AI, Strategy, Design
  icon           String   @default("Code") // Lucide icon name
  featuredImage  String?
  videoUrl       String? // Product video: uploaded file URL or YouTube embed link
  featuresJson   String   // JSON string array of features
  techStackJson  String   // JSON string array of technologies
  processJson    String   // JSON string array of workflow steps
  faqsJson       String?  // JSON string array of FAQs [{q, a}]
  seoTitle       String?
  seoDesc        String?
  order          Int      @default(0)
  isFeatured     Boolean  @default(false)
  status         String   @default("PUBLISHED") // DRAFT, PUBLISHED
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Solution {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  tagline         String?
  category        String   @default("Enterprise") // Enterprise, AI, Cloud, Automation
  shortDesc       String
  fullDesc        String
  featuresJson    String   // JSON string array
  techStackJson   String   // JSON string array
  benefitsJson    String?  // JSON string array
  screenshotsJson String?  // JSON string array of image URLs
  pricingModel    String?  // Custom Quote, Subscription, Tiered
  demoUrl         String?
  docUrl          String?
  status          String   @default("PUBLISHED") // DRAFT, PUBLISHED
  isFeatured      Boolean  @default(false)
  seoTitle        String?
  seoDesc         String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Industry {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  icon           String   @default("Building")
  summary        String
  fullDesc       String
  challengesJson String   // JSON string array
  solutionsJson  String   // JSON string array
  resultsJson    String?  // JSON string array
  featuredImage  String?
  isFeatured     Boolean  @default(false)
  status         String   @default("PUBLISHED")
  seoTitle       String?
  seoDesc        String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model ProjectCaseStudy {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  clientName    String   // Sample/Sanitized client descriptor e.g. "Global FinTech Leader"
  industry      String
  shortDesc     String
  challenge     String
  solution      String
  resultsJson   String   // JSON string array of achievements
  techStackJson String   // JSON string array of technologies
  metricsJson   String?  // JSON string array of metrics e.g. [{"metric":"40%","label":"Efficiency Gain"}]
  imageUrl      String?
  liveUrl       String?
  isFeatured    Boolean  @default(false)
  isSampleData  Boolean  @default(true) // Explicit flag marking sample development data
  status        String   @default("PUBLISHED")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// -------------------------------------------------------------
// 7. CMS: BLOG, CAREERS, TESTIMONIALS, FAQS, OFFICES
// -------------------------------------------------------------

model BlogPost {
  id           String    @id @default(cuid())
  slug         String    @unique
  title        String
  excerpt      String
  content      String    // Markdown or rich text
  coverImage   String?
  authorName   String    @default("EliteGlobex Editorial")
  authorRole   String    @default("Tech Lead")
  authorAvatar String?
  categoryName String    @default("Technology")
  tagsJson     String    // JSON string array of tags
  readingTime  String    @default("5 min read")
  isFeatured   Boolean   @default(false)
  status       String    @default("PUBLISHED") // DRAFT, PUBLISHED
  publishedAt  DateTime? @default(now())
  seoTitle     String?
  seoDesc      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model JobPosition {
  id                  String           @id @default(cuid())
  slug                String           @unique
  title               String
  department          String
  location            String           @default("Global Remote / London / New York")
  employmentType      String           @default("Full-time") // Full-time, Contract, Part-time
  experience          String           @default("3+ Years")
  salaryRange         String?
  description         String
  responsibilitiesJson String          // JSON string array
  requirementsJson    String          // JSON string array
  skillsJson          String          // JSON string array
  deadline            DateTime?
  status              String           @default("OPEN") // OPEN, CLOSED
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  applications JobApplication[]
}

model JobApplication {
  id              String       @id @default(cuid())
  jobId           String
  candidateName   String
  email           String
  phone           String
  resumeUrl       String?      // File link or text resume
  coverLetter     String?
  portfolioUrl    String?
  linkedInUrl     String?
  gitHubUrl       String?
  experienceYears String?
  status          String       @default("SUBMITTED") // SUBMITTED, REVIEWING, INTERVIEW, OFFERED, REJECTED
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  job JobPosition @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Testimonial {
  id            String   @id @default(cuid())
  clientName    String
  clientRole    String
  clientCompany String
  avatarUrl     String?
  feedback      String
  rating        Int      @default(5)
  projectType   String?
  isFeatured    Boolean  @default(false)
  isSampleData  Boolean  @default(true) // Explicit flag marking sample content
  status        String   @default("PUBLISHED")
  order         Int      @default(0)
  createdAt     DateTime @default(now())
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String   @default("General") // General, Services, Security, Pricing, Process
  order     Int      @default(0)
  isPopular Boolean  @default(false)
  status    String   @default("PUBLISHED")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeLocation {
  id           String   @id @default(cuid())
  name         String
  country      String
  state        String?
  city         String
  address      String
  postalCode   String?
  phone        String
  email        String
  mapUrl       String?
  workingHours String   @default("Mon - Fri: 9:00 AM - 6:00 PM (Local)")
  isHQ         Boolean  @default(false)
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model MediaFile {
  id         String   @id @default(cuid())
  fileName   String
  fileUrl    String
  fileType   String   // image/png, application/pdf, etc.
  fileSize   Int      @default(0)
  altText    String?
  uploadedBy String?
  createdAt  DateTime @default(now())
}

model SiteSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  group       String   @default("general") // general, branding, contact, social, seo, footer
  updatedAt   DateTime @updatedAt
}

model RedirectRule {
  id          String   @id @default(cuid())
  fromPath    String   @unique
  toPath      String
  statusCode  Int      @default(301) // 301 or 302
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 8. ORDERS & REAL-TIME TRACKING
// -------------------------------------------------------------

model Order {
  id                 String               @id @default(cuid())
  orderNumber        String               @unique // e.g. "EGX-1001"
  customerName       String
  customerEmail      String
  customerPhone      String?
  customerCompany    String?
  serviceName        String
  amount             Float                @default(0.0)
  currency           String               @default("USD")
  status             String               @default("ORDER_RECEIVED") 
  // ORDER_RECEIVED, PROCESSING, IN_DEVELOPMENT, QUALITY_CHECK, READY, COMPLETED, CANCELLED
  paymentStatus      String               @default("PENDING") 
  // PENDING, PARTIAL, PAID, REFUNDED
  expectedCompletion DateTime?
  assignedToId       String?
  notes              String?
  timelineStepsJson  String?              // Array of steps [{stage, date, completed, description}]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  statusHistory OrderStatusHistory[]
  invoices      Invoice[]
  payments      PaymentRecord[]
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  status    String
  note      String?
  updatedBy String?
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// 9. INVOICES & PAYMENT RECORDS
// -------------------------------------------------------------

model Invoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   @unique // e.g. "INV-2026-001"
  orderId         String?
  customerName    String
  customerEmail   String
  customerCompany String?
  customerAddress String?
  subtotal        Float    @default(0.0)
  tax             Float    @default(0.0)
  discount        Float    @default(0.0)
  total           Float    @default(0.0)
  currency        String   @default("USD")
  status          String   @default("DRAFT") // DRAFT, SENT, PAID, OVERDUE, CANCELLED
  issueDate       DateTime @default(now())
  dueDate         DateTime
  itemsJson       String   // JSON array [{description, quantity, unitPrice, total}]
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  payments PaymentRecord[]
}

model PaymentRecord {
  id             String   @id @default(cuid())
  paymentRef     String   @unique // e.g. "PAY-88219"
  orderId        String?
  invoiceId      String?
  customerName   String
  amount         Float
  currency       String   @default("USD")
  method         String   @default("BANK_TRANSFER") // BANK_TRANSFER, WIRE, STRIPE, RECORD_ONLY
  status         String   @default("SUCCESS") // SUCCESS, PENDING, FAILED
  transactionRef String?
  notes          String?
  paidAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
}

// -------------------------------------------------------------
// 10. INTERNAL PROJECTS & TASK MANAGEMENT (ERP)
// -------------------------------------------------------------

model InternalProject {
  id             String        @id @default(cuid())
  name           String
  code           String        @unique // e.g. "PRJ-CLOUD-01"
  clientName     String
  description    String?
  status         String        @default("ACTIVE") // PLANNING, ACTIVE, ON_HOLD, COMPLETED, CANCELLED
  priority       String        @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  startDate      DateTime      @default(now())
  targetDate     DateTime?
  budget         Float?
  leadEmployeeId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tasks ProjectTask[]
}

model ProjectTask {
  id             String    @id @default(cuid())
  projectId      String
  title          String
  description    String?
  assigneeId     String?
  status         String    @default("TODO") // TODO, IN_PROGRESS, REVIEW, COMPLETED
  priority       String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  dueDate        DateTime?
  estimatedHours Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project  InternalProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?           @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
}

// -------------------------------------------------------------
// 11. HR, ATTENDANCE & LEAVES
// -------------------------------------------------------------

model Employee {
  id             String        @id @default(cuid())
  employeeId     String        @unique // e.g. "EMP-101"
  firstName      String
  lastName       String
  email          String        @unique
  phone          String?
  department     String        // Engineering, Product, AI/Data, Sales, HR, Design
  designation    String        // Senior Full Stack Architect, Cloud Specialist, etc.
  joiningDate    DateTime      @default(now())
  employmentType String        @default("Full-time") // Full-time, Contract, Part-time
  status         String        @default("ACTIVE") // ACTIVE, ON_LEAVE, TERMINATED
  branchId       String?
  avatarUrl      String?
  skillsJson     String?       // JSON array of strings
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  attendances   Attendance[]
  leaveRequests LeaveRequest[]
}

model Attendance {
  id         String    @id @default(cuid())
  employeeId String
  date       DateTime  @default(now())
  checkIn    String?   // "09:00 AM"
  checkOut   String?   // "05:30 PM"
  status     String    @default("PRESENT") // PRESENT, ABSENT, LEAVE, HALF_DAY
  remarks    String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model LeaveRequest {
  id           String   @id @default(cuid())
  employeeId   String
  leaveType    String   // CASUAL, SICK, ANNUAL, UNPAID
  startDate    DateTime
  endDate      DateTime
  totalDays    Int      @default(1)
  reason       String
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  reviewerNote String?
  reviewedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}
